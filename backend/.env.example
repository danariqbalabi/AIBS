# Copy to backend/.env. Fill required values; never commit your .env.
APP_ENV=local
DATABASE_URL=
SUPABASE_URL=
CORS_ORIGINS=[]
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=aibs-food-photos
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_LIMIT=20
RUNTIME_MODE=server
MAX_PHOTO_BYTES=4000000
# Generate a random value >= 16 characters for the protected Vercel cron endpoint.
CRON_SECRET=
